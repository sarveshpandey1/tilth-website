# local preview / tooling config (not part of the published site)
.claude/

# local backup of the original homepage (keep locally, don't publish)
index.original.html
/creative-studio/

# installed deps for tracked tooling (script + package.json are tracked, deps are not)
node_modules/
.vercel

# vercel.json IS tracked: it carries the X-Robots-Tag rule that keeps the
# Vercel deployment hostnames out of the index. Gitignoring it meant the rule
# was never deployed, which is why *.vercel.app was publicly indexable.
# GitHub Pages serves production and ignores this file entirely.
.vercelignore
.vercel
